# Appwrite (project "sasi") — the only backend. Uses the existing "Billing" database.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6ac84fa0002e5ccfa934
NEXT_PUBLIC_APPWRITE_DATABASE_ID=billing_db

# Table IDs inside the database (defaults match the Billing database).
NEXT_PUBLIC_APPWRITE_TABLE_PRODUCTS=products
NEXT_PUBLIC_APPWRITE_TABLE_CLIENTS=clients
NEXT_PUBLIC_APPWRITE_TABLE_SALES=sales

# Server-only API key. Needs users.read, databases.read and tables.read/write.
# Server routes use this to read/write rows; never expose it to the client.
APPWRITE_API_KEY=

# WhatsApp auto-sender (wa-sender service)
WA_SENDER_URL=
WA_SENDER_SECRET=
STORE_WHATSAPP_NUMBER=919087606352
