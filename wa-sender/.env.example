PORT=3101
# Long random string shared with the Next.js site (WA_SENDER_SECRET).
WA_SECRET=change-me-to-a-long-random-string
# Separate lower-privilege token for the link QR page (/qr?token=...).
WA_QR_TOKEN=
# Optional: path to a Chrome/Chromium binary if Puppeteer's bundled
# download is skipped (e.g. a pre-existing cache).
PUPPETEER_EXECUTABLE_PATH=
